# ─── Privy ───────────────────────────────────────────────────────────────────
# Get from https://console.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side only — NEVER prefix with NEXT_PUBLIC_
PRIVY_APP_SECRET=

# ─── RPC ─────────────────────────────────────────────────────────────────────
# Get from https://dashboard.alchemy.com → create app on Base Sepolia
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# Get from https://neon.tech → create project → connection string
DATABASE_URL=

# ─── AI ──────────────────────────────────────────────────────────────────────
# AI_PROVIDER controls which LLM powers the chat.
# Values: "openai" (default) | "qwen"
# Voice transcription always uses OpenAI Whisper regardless of this setting.
AI_PROVIDER=openai

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
# Optional: override the default chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Qwen Cloud — https://dashscope-intl.aliyuncs.com (set AI_PROVIDER=qwen to activate)
# Get API key from https://bailian.console.aliyun.com → API Keys
QWEN_API_KEY=
# Optional: override the default Qwen model (default: qwen-plus)
# Available: qwen-turbo | qwen-plus | qwen-max | qwen3-7b
# QWEN_MODEL=qwen-plus

# ─── Circle Gateway Nanopayments (Base Sepolia) ───────────────────────────────
#
# CIRCLE_BUYER_PRIVATE_KEY
#   Private key of the agent's EOA wallet used to make gas-free nanopayments
#   server-side. NEVER prefix with NEXT_PUBLIC_.
#   Steps:
#     1. Create a new dedicated wallet (MetaMask → Add account → Create account)
#     2. Export private key (Account details → Show private key)
#     3. Fund it with Base Sepolia USDC at https://faucet.circle.com
CIRCLE_BUYER_PRIVATE_KEY=

# CIRCLE_SELLER_ADDRESS
#   EVM address that receives payments via the x402 /api/nanopay/sell endpoint.
#   Can be any wallet address you control.
CIRCLE_SELLER_ADDRESS=

# Optional overrides (leave blank to use defaults)
# CIRCLE_USDC_ADDRESS=       # Default: 0x036CbD53842c5426634e7929541eC2318f3dCF7e (Base Sepolia USDC)
# CIRCLE_GATEWAY_WALLET_ADDRESS=  # Default: fetched from Circle facilitator

# ─── Credible Finance (Banking) ──────────────────────────────────────────────
# Contact Credible Finance representative to get your API credentials.
# Also share your server IP for whitelisting and your webhook endpoint.
#
# Webhook endpoint to register with Credible:  https://<your-domain>/api/banking/webhook
# Base URL is fixed — do not override unless Credible provides a sandbox URL
# CREDIBLE_FINANCE_BASE_URL=https://api.credible.finance/collections/api
CREDIBLE_FINANCE_API_KEY=
CREDIBLE_FINANCE_API_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used by AI tools to call internal API routes (nanopay/*, etc.)
# Set to your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sana Bot ────────────────────────────────────────────────────────────────
# Get from https://sana.bot/gateway/app/api-keys (default scope read:all)
SANABOT_API_KEY=
